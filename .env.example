# Everything here is optional. These values are only used to fill in settings the first time
# the service starts; after that, change settings in the web dashboard.
SMTP_HOSTNAME=smtp.zoho.com
SMTP_PORT=465
SMTP_USERNAME=you@example.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_NAME=Flight Alerter
HOME_LAT=0.0
HOME_LON=0.0
AIRCRAFT_DATA_URL=http://your-adsb-receiver:8080/data/aircraft.json

# Initial dashboard password. If unset, a one-time setup code is printed in the server log instead.
# WEB_PASSWORD=
# Dashboard port (default 8095)
# WEB_PORT=8095
# Set to 1 when the dashboard is served over HTTPS (e.g. behind a reverse proxy)
# WEB_HTTPS=1
